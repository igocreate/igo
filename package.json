{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspace=@igojs/server && npm test --workspace=@igojs/db && npm test --workspace=@igojs/dust && npm test --workspace=@igojs/component",
    "test:dust": "npm test --workspace=@igojs/dust",
    "test:component": "npm test --workspace=@igojs/component",
    "test:server": "npm test --workspace=@igojs/server",
    "test:db": "npm test --workspace=@igojs/db",
    "eslint": "eslint ./packages/*/index.js ./packages/*/src",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "axios": "^1.21.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "serialize-javascript": "^7.1.3",
    "diff": "^8.0.3",
    "vitepress": {
      "vite": "^6.4.4"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
