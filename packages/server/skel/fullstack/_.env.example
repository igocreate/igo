# Copier vers .env — ne jamais committer .env
#
# Ce fichier ne sert qu'à docker compose. La configuration de l'application est
# dans api/.env et front/.env.

# Ports publiés par docker compose. À déplacer si le poste fait déjà tourner un
# MySQL ou un Valkey — et à reporter dans api/.env, que l'application lit.
# MYSQL_PORT=3306
# REDIS_PORT=6379
