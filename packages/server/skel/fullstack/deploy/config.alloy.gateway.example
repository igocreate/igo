// EXEMPLE — à copier en `config.alloy` et à adapter.
//
// COLLECTEUR PARTAGÉ — un seul pour toute l'infrastructure. Il scrute ce qui ne
// tourne pas sur la machine qui l'héberge : base managée, cache, API d'un
// hébergeur. Rien ici ne lit de fichier local.
//
// Le collecteur local, un par machine, vit dans `config.alloy.agent.example`.
//
// C'est ici que la variabilité des hébergeurs est absorbée : le tableau de bord
// interroge `mysql_*`, `redis_*` et `node_*` quelle que soit la plateforme, et
// ce fichier va les chercher là où elles sont. Un projet chez OVH ou Scaleway
// réécrit ce fichier, pas ses tableaux de bord.
//
// À revoir : la destination et les identifiants, les adresses des services, les
// exporteurs selon ce que le projet utilise.
//
// Piège mesuré : les six collecteurs MySQL par défaut produisent 999 séries,
// dont 471 pour `global_variables` — la configuration du serveur, réémise à
// chaque scrutage. Seul `disable_collectors` agit ; `enable_collectors` est
// accepté sans effet.

logging {
  level  = "info"
  format = "logfmt"
}


// ── Destination ─────────────────────────────────────────────────────────────────



prometheus.remote_write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_ID")
      password = sys.env("GRAFANA_TOKEN")
    }
  }
}


// ── Services scrutés à distance ─────────────────────────────────────────────────



// ── Services managés ─────────────────────────────────────────────────────────
//
// C'est l'argument n° 1 retenu par l'ADR contre Sentry : « les intégrations
// services managés font la différence. MySQL et Redis OVH sont monitorés via
// les endpoints standard, avec 80+ métriques et des dashboards pré-construits.
// Sentry ne voit que le code applicatif — la DB et le cache sont des boîtes
// noires. »
//
// En production, ces mêmes blocs visent les endpoints OVH au lieu des
// conteneurs locaux : seule l'adresse change.

prometheus.exporter.mysql "base" {
  // Compte de supervision aux droits minimaux, cf. mysql-init/01-exporter.sql
  data_source_name = "exporter:exporter@(mysql:3306)/"

  // Les six collecteurs par défaut produisent 999 séries. Ceux-ci n'apportent
  // rien au projet et pèsent la moitié du total :
  //
  //   global_variables            471 séries — la *configuration* du serveur,
  //                               donc des constantes réenvoyées à chaque
  //                               scrape : 1,36 million d'échantillons par jour
  //                               pour des valeurs qui ne bougent pas.
  //   info_schema.innodb_cmp       45 séries — compression InnoDB, non utilisée
  //   info_schema.innodb_cmpmem    20 séries — idem
  //
  // Mesuré : 999 séries avant, 475 après — 1,5 million d échantillons par jour
  //
  // Ce qu'on y perd : `max_connections`, qui servait de plafond au panneau des
  // connexions. Le seuil est donc écrit en clair dans le tableau de bord — à
  // revoir si la configuration de MySQL change.
  disable_collectors = [
    "info_schema.innodb_cmp",
    "info_schema.innodb_cmpmem",
  ]
}




prometheus.exporter.redis "cache" {
  // Valkey parle le protocole Redis : l'exporteur Redis fonctionne tel quel.
  redis_addr = "valkey:6379"
}




// `global_variables` renvoie la configuration du serveur — 471 séries de
// constantes réémises à chaque scrape. Deux valent d'être gardées : sans
// `max_connections`, la saturation du pool ne se calcule pas, elle se devine.
// Le collecteur reste donc actif et c'est ce filtre qui jette le reste.
prometheus.relabel "mysql" {
  // RE2 n'a pas d'assertion négative : la conservation passe par une étiquette
  // temporaire, posée sur ce qu'on garde puis relue pour jeter le reste.
  rule {
    source_labels = ["__name__"]
    regex         = "mysql_global_variables_(max_connections|max_user_connections|innodb_buffer_pool_size)"
    target_label  = "__garder__"
    replacement   = "oui"
    action        = "replace"
  }

  rule {
    source_labels = ["__garder__", "__name__"]
    separator     = "@"
    regex         = "@mysql_global_variables_.*"
    action        = "drop"
  }

  rule {
    regex  = "__garder__"
    action = "labeldrop"
  }

  forward_to = [prometheus.relabel.redis.receiver]
}




// Redis envoie 399 séries, dont 268 pour deux familles : l'histogramme de
// latence par commande et ses percentiles — GET, SET, PING, chacun avec ses
// intervalles. Les compteurs agrégés disent la même chose en 1 série.
prometheus.relabel "redis" {
  rule {
    source_labels = ["__name__"]
    regex         = "redis_(commands_latencies_usec.*|latency_percentiles_usec.*|commands_(duration_seconds_total|failed_calls_total|rejected_calls_total|total)|acl_.*|config_client_output_buffer.*|defrag_.*|aof_(rewrite|current|last_cow|last_rewrite).*|slowlog_.*|cluster_.*|sentinel_.*)"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.grafana.receiver]
}


prometheus.scrape "services" {
  targets = concat(
    prometheus.exporter.mysql.base.targets,
    prometheus.exporter.redis.cache.targets,
  )
  forward_to      = [prometheus.relabel.mysql.receiver]
  scrape_interval = "30s"
}


// ── Disponibilité vue de l'extérieur ─────────────────────────────────────────
//
// Une application morte n'émet plus rien : la série disparaît au lieu de valoir
// zéro, et rien ne se déclenche. Mesuré ici — cinq minutes d'API arrêtée, aucune
// des treize règles n'a réagi.
//
// D'où une sonde extérieure au service : `probe_success` existe toujours et vaut
// 0. Depuis la passerelle plutôt que la machine applicative, pour voir tomber
// aussi nginx, le DNS ou le certificat.
prometheus.exporter.blackbox "sondes" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s, http: { valid_status_codes: [200], preferred_ip_protocol: ip4 } } } }"

  target {
    name    = "api"
    address = sys.env("SONDE_URL")
    module  = "http_2xx"
  }
}

// La readiness et non la liveness : `/health` répond 200 base morte comprise.
// `/health/ready` rend 503 dès qu'une dépendance critique manque, et
// `valid_status_codes: [200]` fait tomber `probe_success` avec lui.
prometheus.scrape "sondes" {
  targets         = prometheus.exporter.blackbox.sondes.targets
  forward_to      = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "30s"
}

// ── Bases managées ───────────────────────────────────────────────────────────
//
// Une base managée n'accepte pas d'exporteur : c'est l'hébergeur qui expose ses
// métriques, sous ses propres noms.
//
//   OVHcloud   endpoint Prometheus en HTTPS, port 9273, authentification
//              basique. Joignable seulement depuis le réseau privé de la base.
//              Identifiants par l'API : GET /cloud/project/{projet}/database/mysql/{id}/prometheus
//   Scaleway   par Cockpit, les endpoints par instance ayant été retirés en
//              mars 2026. Fédération Prometheus sur /federate avec un jeton.
//
// Les noms de métriques ne sont documentés ni chez l'un ni chez l'autre : les
// relever sur une instance réelle avant d'écrire les requêtes.
//
// Le renommage se fait ici, pas dans le tableau de bord : celui-ci interroge
// `mysql_*` et `redis_*` quel que soit l'hébergeur, et c'est la passerelle qui
// traduit. Un projet qui change de fournisseur réécrit ce fichier, rien d'autre.
//
// prometheus.scrape "base_managee" {
//   targets = [{
//     __address__ = "mysql-xxxx.database.cloud.ovh.net:9273",
//     __scheme__  = "https",
//   }]
//   basic_auth {
//     username = "prometheus"
//     password = sys.env("OVH_METRIQUES_MOTDEPASSE")
//   }
//   forward_to      = [prometheus.relabel.traduction_hebergeur.receiver]
//   scrape_interval = "30s"
// }
//
// prometheus.relabel "traduction_hebergeur" {
//   // Exemple : ramener un nom propriétaire vers celui qu'attend le tableau de
//   // bord. Les noms réels sont à relever sur l'instance.
//   rule {
//     source_labels = ["__name__"]
//     regex         = "ovh_mysql_connections_active"
//     target_label  = "__name__"
//     replacement   = "mysql_global_status_threads_connected"
//     action        = "replace"
//   }
//
//   forward_to = [prometheus.remote_write.grafana.receiver]
// }
