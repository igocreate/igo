// EXEMPLE — à copier en `config.alloy` et à adapter.
//
// COLLECTEUR PARTAGÉ — un seul pour toute l'infrastructure. Il scrute ce qui ne
// tourne pas sur sa machine : base, cache, disponibilité vue de l'extérieur.
// Le collecteur local, un par machine, vit dans `config.alloy.agent.example`.
//
// C'est ici que s'absorbe la variabilité des hébergeurs : un projet chez OVH ou
// Scaleway réécrit ce fichier, pas ses tableaux de bord.
//
// À revoir : la destination et les identifiants, les adresses des services, les
// exporteurs selon ce que le projet utilise, `PROBE_URL` et `SERVICE_NAMESPACE`
// (le `service.namespace` de l'application).

logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_ID")
      password = sys.env("GRAFANA_TOKEN")
    }
  }
}


// ── MySQL et Valkey auto-hébergés ────────────────────────────────────────────
//
// Une base managée n'accepte pas d'exporteur : voir en bas de fichier.

prometheus.exporter.mysql "mysql" {
  // compte de supervision : GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.*
  data_source_name = "exporter:exporter@(mysql:3306)/"

  // compression InnoDB, non utilisée : 65 séries. Seul `disable_collectors`
  // agit, `enable_collectors` est accepté sans effet.
  disable_collectors = [
    "info_schema.innodb_cmp",
    "info_schema.innodb_cmpmem",
  ]
}

prometheus.exporter.redis "cache" {
  // Valkey parle le protocole Redis
  redis_addr = "valkey:6379"
}

// `global_variables` réémet à chaque scrutage la configuration du serveur :
// 471 séries de constantes. Seules trois sont gardées, dont `max_connections`,
// sans laquelle la saturation du pool se devine au lieu de se calculer.
prometheus.relabel "mysql" {
  // RE2 n'a pas d'assertion négative : ce qu'on garde est marqué, puis le reste
  // de la famille est jeté.
  rule {
    source_labels = ["__name__"]
    regex         = "mysql_global_variables_(max_connections|max_user_connections|innodb_buffer_pool_size)"
    target_label  = "__keep__"
    replacement   = "yes"
    action        = "replace"
  }

  rule {
    source_labels = ["__keep__", "__name__"]
    separator     = "@"
    regex         = "@mysql_global_variables_.*"
    action        = "drop"
  }

  rule {
    regex  = "__keep__"
    action = "labeldrop"
  }

  forward_to = [prometheus.relabel.redis.receiver]
}

// 268 des 399 séries Redis sont les latences par commande et leurs
// percentiles ; les compteurs agrégés disent la même chose.
prometheus.relabel "redis" {
  rule {
    source_labels = ["__name__"]
    regex         = "redis_(commands_latencies_usec.*|latency_percentiles_usec.*|commands_(duration_seconds_total|failed_calls_total|rejected_calls_total|total)|acl_.*|config_client_output_buffer.*|defrag_.*|aof_(rewrite|current|last_cow|last_rewrite).*|slowlog_.*|cluster_.*|sentinel_.*)"
    action        = "drop"
  }

  forward_to = [prometheus.relabel.namespace.receiver]
}

// le projet, filtre des tableaux de bord et des alertes sur une stack partagée
prometheus.relabel "namespace" {
  rule {
    target_label = "service_namespace"
    replacement  = sys.env("SERVICE_NAMESPACE")
  }

  forward_to = [prometheus.remote_write.grafana.receiver]
}

// Grafana Cloud facture au point par minute et par série, un seul inclus :
// 60 s, comme l'agent et l'export de l'application.
prometheus.scrape "services" {
  targets = array.concat(
    prometheus.exporter.mysql.mysql.targets,
    prometheus.exporter.redis.cache.targets,
  )
  forward_to      = [prometheus.relabel.mysql.receiver]
  scrape_interval = "60s"
}


// ── Disponibilité vue de l'extérieur ─────────────────────────────────────────
//
// Une application morte n'émet plus rien : ses séries disparaissent au lieu de
// valoir zéro, et aucune règle ne se déclenche. `probe_success`, lui, existe
// toujours. Depuis la passerelle plutôt que la machine applicative, pour voir
// tomber aussi nginx, le DNS ou le certificat.

prometheus.exporter.blackbox "probes" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s, http: { valid_status_codes: [200], preferred_ip_protocol: ip4 } } } }"

  target {
    name    = "api"
    address = sys.env("PROBE_URL")
    module  = "http_2xx"
  }
}

// La readiness, pas la liveness : `/health` répond 200 base morte comprise,
// `/health/ready` rend 503 dès qu'une dépendance critique manque.
prometheus.scrape "probes" {
  targets         = prometheus.exporter.blackbox.probes.targets
  forward_to      = [prometheus.relabel.namespace.receiver]
  scrape_interval = "60s"
}


// ── Bases managées ───────────────────────────────────────────────────────────
//
// L'hébergeur expose ses propres métriques, sous ses propres noms :
//
//   OVHcloud   endpoint Prometheus sur le nom d'hôte du service, port 9273
//              pour MySQL comme pour Valkey, HTTPS et authentification basique,
//              joignable depuis le réseau privé seulement. Noms au format
//              Telegraf (`mysql_threads_connected`, `redis_used_memory`…), sans
//              `max_connections`. Mot de passe : console, service → Intégration
//              Prometheus, affiché une seule fois.
//   Scaleway   Cockpit, fédération Prometheus sur /federate.
//
// Un bloc par service, chacun avec son mot de passe :
//
// prometheus.scrape "managed_mysql" {
//   targets         = [{ __address__ = "mysql-xxx.database.cloud.ovh.net:9273", service = "mysql" }]
//   scheme          = "https"
//   // certificat signé par le CA du service
//   tls_config { insecure_skip_verify = true }
//   basic_auth {
//     username = "prometheus"
//     password = sys.env("MANAGED_MYSQL_PASSWORD")
//   }
//   forward_to = [prometheus.relabel.rename_metrics.receiver]
// }
//
// // Vers les noms qu'attend le tableau de bord ; sans traduction, écrire les
// // panneaux sur ceux de l'hébergeur.
// prometheus.relabel "rename_metrics" {
//   rule {
//     source_labels = ["__name__"]
//     regex         = "mysql_threads_connected"
//     target_label  = "__name__"
//     replacement   = "mysql_global_status_threads_connected"
//     action        = "replace"
//   }
//   forward_to = [prometheus.relabel.namespace.receiver]
// }
