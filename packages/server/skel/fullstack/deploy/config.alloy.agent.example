// EXEMPLE — à copier en `config.alloy` et à adapter.
//
// COLLECTEUR LOCAL — un par machine. Il lit ce qui n'existe qu'ici : fichiers de
// log, /proc de l'hôte, et l'OTLP que l'application lui envoie en local.
// Ce qui se scrute à distance vit dans `config.alloy.gateway.example`.
//
// À revoir : la destination et les identifiants, les chemins de l'hôte selon
// qu'Alloy tourne en conteneur ou non, `INSTANCE_NAME`, `HOST_ROLE`,
// `SERVICE_NAMESPACE` (le `service.namespace` de l'application), `ENVIRONMENT`
// et le chemin des logs.
//
// Écrit pour Alloy 1.19 : `trace_conditions` et `file_match` dans
// `loki.source.file` sont refusés par les versions plus anciennes.
//
// Côté application, `OTEL_NODE_RESOURCE_DETECTORS=env` : sans lui,
// `process.pid` devient une étiquette et chaque redémarrage ouvre un jeu de
// séries neuf.

logging {
  level  = "info"
  format = "logfmt"
}


// ── Réception ────────────────────────────────────────────────────────────────

otelcol.receiver.otlp "app" {
  // 0.0.0.0 et non localhost : depuis un conteneur, l'application est un hôte
  // distant.
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Sans lot, chaque requête de l'application provoquerait un appel vers Grafana.
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.app_metrics.input]
    // les logs arrivent par fichier (loki.source.file), pas en OTLP
    logs    = []
    traces  = [otelcol.processor.tail_sampling.traces.input]
  }
}


// ── Métriques ────────────────────────────────────────────────────────────────

otelcol.exporter.prometheus "app_metrics" {
  // Désactivée par défaut : sans elle, `service.name`, `service.version` et
  // `deployment.environment.name` ne deviennent pas des étiquettes.
  resource_to_telemetry_conversion = true

  forward_to = [prometheus.relabel.app_metrics.receiver]
}

// Les attributs `process_*` changeraient à chaque redémarrage, et les sondes de
// santé feraient l'essentiel du trafic mesuré.
prometheus.relabel "app_metrics" {
  rule {
    regex  = "process_(pid|command|command_args|executable_name|executable_path|owner|runtime_description)"
    action = "labeldrop"
  }

  rule {
    source_labels = ["http_route"]
    regex         = "/health(/.*)?"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.grafana.receiver]
}

prometheus.remote_write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_ID")
      password = sys.env("GRAFANA_TOKEN")
    }
  }
}


// ── Traces ───────────────────────────────────────────────────────────────────
//
// Toutes les traces en erreur, et un échantillon du nominal : débit et latence
// viennent des métriques.

// « tail » : décidé une fois la trace complète. Une politique suffit à la garder.
otelcol.processor.tail_sampling "traces" {
  // au-delà de la latence maximale d'une requête, sinon une trace lente serait
  // jugée avant d'être terminée
  decision_wait = "10s"

  // L'instrumentation HTTP ne marque en ERROR que les 5xx. Les 4xx ne sont pas
  // retenus : un refus est décidé en mémoire, et la ligne de log porte déjà le
  // corps, les paramètres et la réponse.
  policy {
    name = "server_errors"
    type = "status_code"

    status_code {
      status_codes = ["ERROR"]
    }
  }

  // Pas de seuil de latence : il suppose de connaître la latence normale de
  // chaque route. Le P95 vient des métriques, et cet échantillon donne des
  // traces d'exemple.
  policy {
    name = "baseline_sample"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = 10
    }
  }

  output {
    traces = [otelcol.processor.filter.spans.input]
  }
}

// Les spans de middleware ne pèsent rien dans la durée d'une requête. Restent
// le span racine, `request handler` et les requêtes SQL.
otelcol.processor.filter "spans" {
  error_mode = "ignore"

  trace_conditions {
    context    = "span"
    conditions = [
      "IsMatch(name, \"^(middleware|router) - \")",
    ]
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// Tempo n'ingère qu'en gRPC : endpoint réduit à `hôte:443`, sans chemin. La
// variante HTTP répond 404 sur tous les chemins.
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = sys.env("GRAFANA_TRACES_URL")
    auth     = otelcol.auth.basic.tempo.handler
  }
}

otelcol.auth.basic "tempo" {
  username = sys.env("GRAFANA_TRACES_ID")
  password = sys.env("GRAFANA_TOKEN")
}


// ── Métriques système ────────────────────────────────────────────────────────

// En conteneur, Alloy ne voit que son propre /proc : `- /:/host:ro` dans le
// compose lui donne celui de la machine. Installé nativement, retirer les trois
// chemins.
prometheus.exporter.unix "host" {
  rootfs_path = "/host"
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"

  // ceux que lisent le tableau de bord et les alertes : 890 séries au lieu de
  // 1663 par défaut
  set_collectors = [
    "cpu", "meminfo", "filesystem", "diskstats", "netdev",
    "loadavg",
    "filefd", "pressure", "vmstat", "stat",
    "uname", "time",
  ]

  // un hôte conteneurisé présente des dizaines de montages sans intérêt
  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|ramfs|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tmpfs|tracefs|virtiofs)$"
  }

  // les périphériques virtuels restent plats et noient les vrais disques
  disk {
    device_exclude = "^(nbd|zram|ram|loop|fd|dm-|sr|md|dasd)\\d+$"
  }
}

prometheus.relabel "host_metrics" {
  // En conteneur, `instance` vaut un nom d'hôte que Docker tire au sort : chaque
  // recréation abandonne ~700 séries et en ouvre autant. `node_*` seulement :
  // l'`instance` de MySQL et de Redis est l'adresse de la cible, déjà stable.
  rule {
    source_labels = ["__name__"]
    regex         = "node_.*"
    target_label  = "instance"
    replacement   = sys.env("INSTANCE_NAME")
    action        = "replace"
  }

  // Ce que lisent le tableau de bord et les alertes, plus de quoi creuser d'un
  // cran : une métrique ajoutée au tableau de bord s'ajoute ici. `keep` jette
  // tout le reste, d'où `mysql|redis|probe` dans la liste.
  rule {
    source_labels = ["__name__"]
    regex = "(mysql|redis|probe|up|scrape)_.*|node_(cpu_seconds_total|load[0-9]+|memory_(MemTotal|MemAvailable|MemFree|Cached|Buffers|SwapTotal|SwapFree)_bytes|filesystem_(avail|size)_bytes|filesystem_(readonly|files|files_free)|disk_(io_time_seconds_total|io_time_weighted_seconds_total|read_bytes_total|written_bytes_total|reads_completed_total|writes_completed_total)|network_(receive|transmit)_(bytes|errs|drop)_total|pressure_(cpu|io|memory)_(waiting|stalled)_seconds_total|filefd_(allocated|maximum)|procs_(running|blocked)|context_switches_total|intr_total|forks_total|vmstat_(pgpgin|pgpgout|pswpin|pswpout|pgmajfault)|boot_time_seconds|uname_info|time_seconds)"
    action = "keep"
  }

  // Ce que porte la machine — `app`, `mysql`, `valkey` —, pour ranger processeur
  // et mémoire sous le service concerné. Une machine qui en porte plusieurs n'en
  // nomme qu'un : son processeur est commun.
  rule {
    source_labels = ["__name__"]
    regex         = "node_.*"
    target_label  = "role"
    replacement   = sys.env("HOST_ROLE")
    action        = "replace"
  }

  // le projet, filtre des tableaux de bord et des alertes sur une stack partagée
  rule {
    target_label = "service_namespace"
    replacement  = sys.env("SERVICE_NAMESPACE")
  }

  forward_to = [prometheus.remote_write.grafana.receiver]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.host_metrics.receiver]
  // Grafana Cloud facture au point par minute et par série, un seul inclus
  scrape_interval = "60s"
}


// ── Logs de l'application ────────────────────────────────────────────────────
//
// Suivis dans un fichier plutôt que poussés en OTLP : une application qui meurt
// perdrait ses dernières lignes, précisément celles qu'on cherche. En
// production, celui de pm2 (`~/.pm2/logs/<app>-out.log`).

// L'environnement est celui de la machine, pas lu dans la ligne : une ligne mal
// formée ou écrite par autre chose qu'igo serait sinon rangée nulle part. Sans
// ENVIRONMENT, l'étiquette manque, sans erreur.
loki.source.file "app" {
  targets = [{
    __path__          = "/var/log/{project.name}/*.log",
    service_namespace = "{project.name}",
    service_name      = "{project.name}-api",
    environment       = sys.env("ENVIRONMENT"),
    // sans elle, les logs de deux machines sont indiscernables
    instance          = sys.env("INSTANCE_NAME"),
  }]
  forward_to = [loki.process.json.receiver]

  // le motif `*.log` est relu : un fichier apparu après le démarrage est suivi
  file_match {
    enabled = true
  }

  // Sans position enregistrée, le premier démarrage relirait tout le fichier :
  // sur un journal pm2 jamais tourné, des mois d'historique et le quota dépassé.
  tail_from_end = true
}

loki.process "json" {
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.grafana.receiver]
}

loki.write "grafana" {
  endpoint {
    url = sys.env("GRAFANA_LOGS_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOGS_ID")
      password = sys.env("GRAFANA_TOKEN")
    }
  }
}
