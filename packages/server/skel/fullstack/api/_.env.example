# Copy to .env — never commit .env
NODE_ENV=dev
HTTP_PORT=3000

# Sessions: generate with `openssl rand -hex 32`. igo refuses to start in
# production with the default values.
COOKIE_SECRET=
COOKIE_SESSION_KEYS=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# json in production, human elsewhere
# LOG_FORMAT=json
# LOG_LEVEL=info

# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
